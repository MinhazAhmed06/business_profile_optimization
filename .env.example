# ==============================================================================
# GBP RANK TRACKER SAAS - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and replace the placeholder values with your production credentials.

# ------------------------------------------------------------------------------
# 1. DATABASE (PostgreSQL - Neon, Supabase, Railway, AWS RDS, etc.)
# ------------------------------------------------------------------------------
# DATABASE_URL: Transaction-pooled connection string (e.g., PgBouncer / port 6543)
DATABASE_URL="postgresql://postgres:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL: Direct unpooled connection string (used by Prisma migrations / port 5432)
DIRECT_URL="postgresql://postgres:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION (Clerk - https://clerk.com)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk URL routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# ------------------------------------------------------------------------------
# 3. SERP PROVIDER (DataForSEO & Serper.dev)
# ------------------------------------------------------------------------------
# Set to "dataforseo" (recommended) or "serper"
PRIMARY_SERP_PROVIDER="dataforseo"

# DataForSEO Credentials (https://dataforseo.com)
DATAFORSEO_LOGIN="your-dataforseo-login"
DATAFORSEO_PASSWORD="your-dataforseo-password"

# Serper.dev Credentials (https://serper.dev - provides automatic fallback & reviews)
SERPER_API_KEY="your-serper-api-key"

# Concurrency limit for parallel grid point scanning (default: 15)
SERP_CONCURRENCY_LIMIT=15

# ------------------------------------------------------------------------------
# 4. BILLING & SUBSCRIPTIONS (Dodo Payments / Paddle)
# ------------------------------------------------------------------------------
# Secret from your Dodo Payments or Paddle Webhook Dashboard
DODO_PAYMENTS_WEBHOOK_SECRET="whsec_..."
PADDLE_WEBHOOK_SECRET="pdl_..."
# Generic fallback webhook secret
BILLING_WEBHOOK_SECRET="your-webhook-secret"

# ------------------------------------------------------------------------------
# 5. OPTIONAL / DEV OVERRIDES
# ------------------------------------------------------------------------------
# DEV_USER_ID="user_dev_local"
