datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String              @id // Clerk User ID (user_xxx)
  email               String              @unique
  name                String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  
  // Credits & Billing
  credits             Int                 @default(150) // 150 free credits on signup
  plan                String              @default("FREE") // FREE, PRO ($99), AGENCY ($149)
  subscriptionId      String?             // Dodo Payments / Paddle Subscription ID
  customerId          String?             // Dodo / Paddle Customer ID
  subscriptionStatus  String              @default("INACTIVE") // ACTIVE, PAST_DUE, CANCELLED
  
  // White-Label Agency Branding
  agencyName          String?
  agencyLogoUrl       String?
  brandColor          String?             @default("#2563eb")
  bookingUrl          String?             // Calendly / Cal.com link for lead generation
  websiteUrl          String?
  
  // Relations
  scans               Scan[]
  savedBusinesses     SavedBusiness[]
  creditTransactions  CreditTransaction[]
  presets             GridPreset[]
  reviewAnalyses      ReviewAnalysis[]

  @@index([email])
}

model CreditTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Int      // e.g. -49 for scan, +5000 for plan refill, +49 for refund
  type        String   // SIGNUP_BONUS, SCAN_DEDUCTION, SCAN_REFUND, SUBSCRIPTION_REFILL, PACK_PURCHASE
  description String
  scanId      String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Scan {
  id            String      @id @default(cuid())
  userId        String?     @default("user_dev_local")
  user          User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Public Pitch & Sharing
  shareSlug     String?     @unique // e.g. "audit-k8d2p9x" for public client view
  isPublic      Boolean     @default(true)
  
  keyword       String
  createdAt     DateTime    @default(now())
  status        String      @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED
  centerLat     Float
  centerLng     Float
  radius        Float
  gridSize      Int         @default(3) // 3x3, 5x5, 7x7, 9x9, 13x13
  shape         String      @default("SQUARE") // SQUARE, CIRCLE, ZIP
  customPoints  String?     // JSON string of manual coordinates
  frequency     String      @default("ONCE") // ONCE, DAILY, WEEKLY
  nextRun       DateTime?
  
  businessName  String?     // Target business name to track
  placeId       String?     // Target Google Place ID
  websiteUrl    String?     // Target business website (user-provided or auto-discovered)
  
  // Aggregated SERP Metrics
  arp           Float?      // Average Rank Position (across found pins)
  atrp          Float?      // Average Total Rank Position (penalizes unranked pins with 21)
  sov           Float?      // Share of Voice percentage (0-100%)
  pinsCount     Int         @default(0)
  top3Count     Int         @default(0)
  top10Count    Int         @default(0)
  unrankedCount Int         @default(0)
  
  // Pitch & Audit Intelligence (Phase 2)
  onPageAudit   String?     // JSON: Title, meta description, H1, SSL, speed, schema
  aiPitchReport String?     // JSON: Top competitor analysis & cold pitch script
  
  currentRunId  String?
  results       Result[]

  @@index([userId])
  @@index([shareSlug])
  @@index([status])
  @@index([createdAt])
}

model Result {
  id           String   @id @default(cuid())
  scanId       String
  scan         Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  runId        String?
  runAt        DateTime @default(now())
  lat          Float
  lng          Float
  rank         Int?     // null if target business is not in top 20
  targetName   String?
  placeId      String?
  cid          String?
  topResults   String   // JSON string of top 20 competitors at this coordinate
  capturedAt   DateTime @default(now())

  @@index([scanId])
  @@index([scanId, runId])
}

model SavedBusiness {
  id           String   @id @default(cuid())
  userId       String?  @default("user_dev_local")
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  placeId      String?
  address      String?
  phone        String?
  website      String?
  category     String?
  googleUrl    String?
  lat          Float?
  lng          Float?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())

  @@index([userId])
  @@index([name])
}

model GridPreset {
  id           String   @id @default(cuid())
  userId       String?  @default("user_dev_local")
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  centerLat    Float
  centerLng    Float
  radius       Float
  gridSize     Int      @default(3)
  shape        String   @default("SQUARE")
  customPoints String?
  locationName String?
  createdAt    DateTime @default(now())

  @@index([userId])
}

model ReviewAnalysis {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName  String
  businessUrl   String
  placeId       String?
  totalReviews  Int      @default(0)
  averageRating Float    @default(0)
  analysisData  String?  // JSON blob of sentiment metrics
  status        String   @default("PENDING")
  error         String?
  createdAt     DateTime @default(now())
  reviews       Review[]

  @@index([userId])
  @@index([status])
}

model Review {
  id              String         @id @default(cuid())
  analysisId      String
  analysis        ReviewAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  runId           String?
  runAt           DateTime       @default(now())
  reviewerName    String
  reviewerUrl     String?
  reviewImage     String?
  reviewCount     Int?
  photoCount      Int?
  rating          Int
  text            String?
  publishedDate   String?
  responseText    String?
  responseDate    String?
  sentimentScore  Float?
  sentimentLabel  String?
  isLikelyFake    Boolean        @default(false)
  fakeScore       Float?
  analysisBlob    String?

  @@index([analysisId])
}

model Proxy {
  id           String    @id @default(cuid())
  host         String
  port         Int
  username     String?
  password     String?
  type         String    @default("RESIDENTIAL")
  enabled      Boolean   @default(true)
  status       String    @default("UNTESTED")
  lastTestedAt DateTime?
  createdAt    DateTime  @default(now())

  @@unique([host, port])
}

model Alert {
  id        String   @id @default(cuid())
  type      String   // RANK_UP, RANK_DOWN, SCAN_ERROR
  message   String
  scanId    String
  createdAt DateTime @default(now())
  read      Boolean  @default(false)

  @@index([read])
  @@index([scanId])
}

model GlobalSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model SystemLog {
  id        String   @id @default(cuid())
  level     String   @default("INFO") // INFO, WARN, ERROR, DEBUG
  message   String
  source    String?  // e.g., "SCANNER", "PROXY_FETCHER", "API"
  details   String?  // JSON string for extra data
  createdAt DateTime @default(now())
}

model Webhook {
  id        String   @id @default(cuid())
  url       String
  events    String   // JSON array: ["SCAN_COMPLETE","RANK_CHANGE","SCAN_FAILED"]
  secret    String?  // Optional HMAC-SHA256 signing secret
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([enabled])
}
